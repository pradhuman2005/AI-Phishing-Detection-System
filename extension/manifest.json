{
  "manifest_version": 3,
  "name": "Email Safety Checker",
  "version": "1.0.0",
  "description": "Shows whether an email in Gmail is safe or risky, with a simple full report.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}