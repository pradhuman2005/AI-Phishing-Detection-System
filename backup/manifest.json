
{
  "manifest_version": 3,
  "name": "AI Mail Guardian",
  "version": "1.1.0",
  "description": "AI-powered email threat analysis for Gmail",
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:5678/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI Mail Guardian"
  }
}
